NODE_ENV=development
PORT=5000
DATABASE_URL=mongodb://127.0.0.1:27017/api-boilerplate
CORS_ORIGIN=http://localhost:3000

BCRYPT_SALT_ROUNDS=12

JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=365d

# created on first boot when no super admin exists (optional)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# forgot password mail (gmail smtp + app password)
RESET_PASS_UI_LINK=http://localhost:3000/reset-password?
EMAIL=
APP_PASS=
